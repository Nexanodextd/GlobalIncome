<%- include('user_partials/header') %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      
      <div class="row ">
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
          <div class="card">
            <div class="card-statistic-4">
              <div class="align-items-center justify-content-between">
                <div class="row ">
                  <div class="col-lg-12 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                    <div class="card-content">
                      <h2 class="font-12"><i class="fa-solid fa-wallet"></i> Account Balance</h2>
                      <h2 class="mb-3 font-18">$<%= wallet.balance %></h2>
                      <p class="mb-0 font-10"><i class="fa fa-calendar" style="color:goldenrod"></i> Total Available Balance</p>
                      
                    </div>
                    
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
          <div class="card">
            <div class="card-statistic-4">
              <div class="align-items-center justify-content-between">
                <div class="row ">
                  <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                    <div class="card-content">
                      <h5 class="font-12"><i class="fa fa-plus"></i> Total Profit</h5>
                      <h2 class="mb-3 font-18">$<%= wallet.profit %></h2>
                      <p class="mb-0 font-10"><i class="fa fa-calendar" style="color:goldenrod"></i> included in Balance</p>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
          <div class="card">
            <div class="card-statistic-4">
              <div class="align-items-center justify-content-between">
                <div class="row ">
                  <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                    <div class="card-content">
                      <h5 class="font-12">Total Withdrawal</h5>
                      <h2 class="mb-3 font-18">$128</h2>
                      <p class="mb-0 font-10"> <i class="fa fa-calendar" style="color:goldenrod"></i> All time</p>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
          <div class="card">
            <div class="card-statistic-4">
              <div class="align-items-center justify-content-between">
                <div class="row ">
                  <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                    <div class="card-content">
                      <h5 class="font-12">Bonus</h5>
                      <h2 class="mb-3 font-18">$<%= wallet.bonus %></h2>
                      <p class="mb-0 font-10"><i class="fa fa-calendar" style="color:goldenrod"></i> All time</p>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row"><!--KYC SECTION-->
        <% if ( kyc.status=="pending") { %>

           <div class="col-12 col-sm-12 col-lg-12">

           <div class="card">
               <div class="alert alert-dark alert-has-icon" style="width: 98%; margin: auto; margin-top: 2%; margin-bottom:2%;">
                      <div class="alert-icon"><i class="far fa-lightbulb"></i></div>
                      <div class="alert-body">
                        <div class="alert-title">Hey there, is it really you?</div>
                              Verifying your information helps us prevent someone else from creating an account in your name.
                      </div>
                    </div>
           </div>

         </div>
         
        <% } %>
        
      </div><!--END OF KYC SECTION-->

      <div class="row">
        <div class="col-12 col-sm-12 col-lg-8">
          <div class="card ">
            <div class="card-header">
              <h4>Live Trading Chat</h4>
              <div class="card-header-action">
                <div class="dropdown">
                  <a href="#" data-toggle="dropdown" class="btn btn-warning dropdown-toggle">Options</a>
                  <div class="dropdown-menu">
                    <a href="#" class="dropdown-item has-icon"><i class="fas fa-eye"></i> View</a>
                    <a href="#" class="dropdown-item has-icon"><i class="far fa-edit"></i> Edit</a>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item has-icon text-danger"><i class="far fa-trash-alt"></i>
                      Delete</a>
                  </div>
                </div>
                <a href="#" class="btn btn-primary">View All</a>
              </div>
            </div>
            <div class="card-body">
              <div class="tradingview-widget-container">
                <div id="tv_chart" style="height: 500px;"></div>
              </div>
            </div>
          </div>
        </div>
          
        


        <div class="col-12 col-sm-12 col-lg-4">
          <!-- Quick Trade -->
          <div class="card text-center text-white p-4 border-0 mb-3"
            style="background: linear-gradient(135deg,#4f46e5,#3b82f6);">

            <h4>⚡ Quick Trade</h4>
            <p class="mb-0">Start a new trade instantly or explore investment plans.</p>
               <a class="btn btn-info" href="/deposit" style="color:white "><i class="fa-solid fa-plus" sty></i> Deposite</a>
          </div>
          <div class="card ">
            <div class="card-header">
              <a href="#" class="btn btn-primary"> <i class="fa-solid fa-chart-area" style="color: forestgreen;"></i>
                Place a Trade</a>
            </div>
            <div class="card-body">
              <form id="trade_form">


                <div class="form-group">
                  <label>Assets</label>
                  <select name="" id="" class="form-control">
                    <option value="USDT/BTC">USDT/BTC</option>
                    <option value="USDT/ETH">USDT/ETH</option>
                    <option value="USDT/SOL">USDT/SOL</option>
                    <option value="USDT/LTC">USDT/LTC</option>
                    <option value="USDT/XRP">USDT/XRP</option>
                  </select>
                </div>

                <div class="form-group">
                  <label>Amount</label>
                  <div class="input-group">
                    <div class="input-group-prepend">
                      <div class="input-group-text">
                        <i class="fa-solid fa-dollar-sign"></i>
                      </div>
                    </div>
                    <input type="text" class="form-control phone-currency" placeholder="Minimum 5000">

                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Leverage</label>
                      <select name="" id="" class="form-control">
                        <option value="1x">1x</option>
                         <option value="2x">2x</option>
                          <option value="5x">5x</option>
                           <option value="10x">10x</option>
                            <option value="50x">50x</option>
                             <option value="100x">100x</option>
                      </select>
                    </div>

                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Expiration</label>
                      <select name="" id="expiration" class="form-control">
                        <option value="1 Minute">1 Minute</option>
                         <option value="5 Minutes">5 Minutes</option>
                          <option value="15 Minutes">15 Minutes</option>
                           <option value="30 Minutes">30 Minutes</option>
                            <option value="1 Hour">1 hours</option>
                             <option value="7 hours">7 hours</option>
                             <option value="24 hours">14 hours</option>
                      </select>
                    </div>

                  </div>
                </div>
                <div class="row">
                  <div class="col-12 col-md-6">
                    <button type="submit" style="width: 90%; margin-bottom: 2%;" name="order_type" value="Buy"
                      class="btn btn-success"
                      class="flex-1 bg-gradient-to-br from-green-500 to-emerald-600 text-white py-2 sm:py-3 rounded-xl shadow hover:opacity-90 transition-all flex items-center justify-center gap-2 text-sm sm:text-base font-semibold">
                      <i class="fa-solid fa-arrow-trend-up"></i> BUY
                    </button>

                  </div>
                  <div class=" col-12 col-md-6">
                    <button type="submit" style="width: 90%;" name="order_type" class="btn btn-danger" value="Sell"
                      class="flex-1 bg-gradient-to-br from-red-500 to-pink-600 text-white py-2 sm:py-3 rounded-xl shadow hover:opacity-90 transition-all flex items-center justify-center gap-2 text-sm sm:text-base font-semibold">
                      <i class="fa-solid fa-arrow-trend-down"></i> SELL
                    </button>
                  </div>
                </div>

              </form>
            </div>
          </div>
        </div>

      </div>
      <div class="row">
        <div class="col-12 col-sm-12 col-lg-6">
          <div class="card">
            <div class="card-header">
              <h4 id="selectedCoin">BTC: <span id="price"></span></h4>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover">
                  <tbody id="cryptoTable"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-12 col-lg-6">
          <div class="card">
            <div class="card-header">
              <h4>Chart</h4>
            </div>
            <div class="card-body">
              <div id="chart"></div>
            </div>
          </div>
        </div>

      </div>
      <div class="row" style="margin-bottom: 2%;">
        <div class="col-12">
          <div class="ref-card shadow">

            <!-- Title -->
            <h4 class="mb-2">Referrals</h4>
            <p class="text-light opacity-75">
              Present our project to your network and enjoy financial benefits.
              You don’t need an active deposit to earn affiliate commissions.
            </p>

            <!-- Button -->
            <button class="btn btn-primary mb-4">Learn More</button>

            <!-- Referral Link -->
            <div>
              <h6 class="mb-2">Personal Referral Code</h6>

              <div class="d-flex align-items-center gap-2">

                <div class="ref-link-box flex-grow-1" id="refLink">
                   <%= user.referralCode %>
                </div>

                <button class="btn copy-btn text-white px-3" onclick="copyLink()" style="margin-left: 1;">
                  Copy
                </button>

              </div>
            </div>

          </div>

        </div>
      </div>

      <div class="container-fluid py-3"><!--crypto market begin-->
        <div class="row g-3 " id="cards" style="margin-bottom: 1%;"></div>
      </div><!--crypto market end-->

    </section>

  </div>
  <%- include('user_partials/footer') %>