  <script>
    $(document).ready(function () {
        loadPortfolio();
        getwalletBalance();
       setInterval(function () {
        loadPortfolio();
        getwalletBalance();
    }, 5000);
      
    })

    function loadPortfolio() {
      $.ajax({
        url: '/trade_api/portfolio',
        type: 'GET',
        success: function (res) {
          if (!res.success) {
            return
          }
          const summary = res.summary;

          $("#totalInvested").text(
            "$" + summary.totalInvested.toLocaleString()
          );

          $("#totalCurrentValue").text(
            "$" + summary.totalCurrentValue.toLocaleString({ minimumFractionDigits: 1 },{maximuFractionDigits:2})
          );
          const ProfitLoss = summary.totalProfitLoss;
          $("#totalProfitLoss").text(
            "$" + ProfitLoss.toLocaleString()
          ).removeClass("text-danger text-success text-secondary")
            .addClass(
              ProfitLoss < 0
                ? "text-danger"
                : ProfitLoss > 0
                  ? "text-success"
                  : "text-secondary"
            );
          const percentage = summary.totalProfitLossPercentage;
          $("#totalProfitLossPercentage").text(percentage.toFixed(1) + "%").removeClass("text-danger text-success text-secondary")
            .addClass(
              percentage < 0
                ? "text-danger"
                : percentage > 0
                  ? "text-success"
                  : "text-secondary"
            );
            
        },
        error: function (error) {
          console.log(error);
        }
      })
    }

    function getwalletBalance() {

      $.ajax({
        url: "/api/getUserBalance",
        type: "GET",
        success: function (res) {
          if (!res.success) {
            console.log("no data found");
            alert("no data found");
          }
          const data = res.data
          console.log(data)
          $('#walletBalance').text("$" + data.balance.toLocaleString({ minimumFractionDigits: 2 }))
          $("#totalProfit").text("$" + data.profit.toLocaleString({ minimumFractionDigits: 2 }))
          $("#bonus").text("$" + data.bonus.toLocaleString({ minimumFractionDigits: 2 }))

        }
      })

    }

  </script>
