<%- include('user_partials/header') %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="section-body">



        <div class="container py-5">

          <!-- HEADER -->
         <!--- <div class="top-section  mb-5" style="margin-top: -14%;">
            <h1>Fund Your Account</h1>
            <p>Secure deposits to start trading</p>
          </div>-->

          <!-- ALERT -->
          <div class="alert alert-danger alert-dismissible show fade justify-content-center mb-5">
             
            <div class="alert-body">
              <i class="bi bi-exclamation-circle"></i>
              <button class="close" data-dismiss="alert">
                <span>&times;</span>
              </button>
              This is a success alert. Your account is insufficient to purchase this plan.
              Please make a deposit.
            </div>
          </div>

          <!-- QUICK AMOUNTS -->
          <div class="text-center mb-5">

            <p class="text-secondary mb-3">
              Quick amounts:
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">

              <button class="quick-btn" data-amount="100">$100</button>
              <button class="quick-btn" data-amount="500">$500</button>
              <button class="quick-btn" data-amount="1000">$1,000</button>
              <button class="quick-btn" data-amount="5000">$5,000</button>

            </div>

          </div>

          <!-- MAIN CONTENT -->
          <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8" style="margin-bottom: 2%;">

              <div class="card-custom">

                <div class="d-flex justify-content-between align-items-center mb-4">

                  <h3 class="mb-0">
                    Make a Deposit
                  </h3>

                  <div class="secure-badge">
                    <i class="bi bi-shield-check"></i>
                    Secure
                  </div>

                </div>

                <form>

                  <!-- PAYMENT METHOD -->
                  <div class="mb-4">

                    <label>
                      Payment Method *
                    </label>

                    <select class="form-select form-control" style="height:50px" >

                      <option>USDT</option>
                      <option>Bitcoin</option>
                      <option>Ethereum</option>

                    </select>

                  </div>

                  <!-- AMOUNT -->
                  <div class="mb-4">

                    <label>
                      Amount to Deposit *
                    </label>

                    <input type="text" id="depositAmount" class="form-control" placeholder="Enter amount" style="height:50px" />

                  </div>

                  <!-- WALLET -->
                 <!----<div class="mb-4">

                    <label>
                      Wallet Address
                    </label>

                    <input type="text" class="form-control" placeholder="Wallet address" />

                  </div>-->

                  <!-- BUTTON -->
                  <button class="btn deposit-btn w-100" id="payment">

                    <i class="bi bi-credit-card"></i>
                    Deposit Funds

                  </button>

                </form>

              </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">

              <div class="card-custom">

                <h3 class="mb-4">
                  Payment Methods
                </h3>

                <div class="payment-item">

                  <i class="bi bi-wallet2"></i>

                  <span>USDT</span>

                </div>

                <div class="payment-item">

                  <i class="bi bi-currency-bitcoin"></i>

                  <span>Bitcoin</span>

                </div>

                <div class="payment-item">

                  <i class="bi bi-currency-exchange"></i>

                  <span>Ethereum</span>

                </div>

              </div>

            </div>

          </div>

        </div>



      </div><!--end of section body-->
    </section>

  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <a href="">Global Invest</a></a>
    </div>
    <div class="footer-right">
    </div>
  </footer>
  </div>
  </div>
  <!-- General JS Scripts -->
  <script src="assets/js/app.min.js"></script>
  <!-- JS Libraies -->
  <!-- Page Specific JS File -->
  <!-- Template JS File -->
  <script src="assets/js/scripts.js"></script>
  <!-- Custom JS File -->
  <script src="assets/js/custom.js"></script>
  <script>
     $(document).ready(function(){
        alert('i am working')
     })
      $(".quick-btn").click(function(){

      // GET BUTTON AMOUNT
      let amount =
      $(this).data("amount");

      // DISPLAY IN INPUT
      $("#depositAmount").val(amount);

  });
  $('#payment').on('click',function(e){
      e.preventDefault();
      location.href='/payment'
  })
  </script>
  </body>


