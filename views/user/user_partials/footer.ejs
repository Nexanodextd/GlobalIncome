    }, 30000);
});
</script>

<script>
function copyLink() {
  const text = document.getElementById("refLink").innerText;
  navigator.clipboard.writeText(text);

  alert("Copied!");
}

const assets = [
  { id: "bitcoin", type: "crypto", symbol: "BTC/USDT", name: "Bitcoin" },
  { id: "ethereum", type: "crypto", symbol: "ETH/USDT", name: "Ethereum" },
  { id: "eurusd", type: "forex", symbol: "EUR/USD", name: "Euro / U.S." },
  { id: "gbpusd", type: "forex", symbol: "GBP/USD", name: "British Pound" },
  { id: "AAPL", type: "stock", symbol: "AAPL", name: "Apple Inc" },
  { id: "gold", type: "gold", symbol: "GOLD", name: "CFDs on Gold" }
];

async function loadData() {

  let html = "";

  // 🔥 Crypto (CoinGecko)
  const crypto = await $.get("https://api.coingecko.com/api/v3/coins/markets", {
    vs_currency: "usd",
    ids: "bitcoin,ethereum",
    sparkline: true,
    price_change_percentage: "24h"
  });

  // Fake demo data for forex/stock/gold (replace with real APIs later)
  const extra = {
    eurusd: { price: 1.17, change: 0.3 },
    gbpusd: { price: 1.35, change: 0.2 },
    AAPL: { price: 284, change: -0.5 },
    gold: { price: 4650, change: 0.8 }
  };

  assets.forEach((asset, i) => {

    let price = 0;
    let change = 0;
    let sparkData = [];

    if (asset.type === "crypto") {
      const coin = crypto.find(c => c.id === asset.id);
      price = coin.current_price;
      change = coin.price_change_percentage_24h;
      sparkData = coin.sparkline_in_7d.price.slice(-20);
    } else {
      price = extra[asset.id].price;
      change = extra[asset.id].change;

      // Fake mini chart
      sparkData = Array.from({length: 20}, () => price + Math.random()*2);
    }

    const colorClass = change >= 0 ? "positive" : "negative";
    const chartId = "chart" + i;

    html += `
      <div class="col-6 col-md-4 col-lg-2" style="margin-bottom:1%;">
        <div class="market-card">

          <div class="d-flex justify-content-between">
            <div>
              <div class="symbol">${asset.symbol}</div>
              <div class="name">${asset.name}</div>
            </div>
          </div>

          <div class="price ${colorClass}">
            ${price.toLocaleString()}
          </div>

          <div id="${chartId}" class="spark"></div>

          <div class="d-flex justify-content-between">
            <span class="time">06:00</span>
            <span class="time">18:00</span>
          </div>

        </div>
      </div>
    `;

    setTimeout(() => {
      new ApexCharts(document.querySelector("#" + chartId), {
        chart: {
          type: "line",
          height: 50,
          sparkline: { enabled: true }
        },
        stroke: { width: 2, curve: "smooth" },
        colors: [change >= 0 ? "#22c55e" : "#ef4444"],
        series: [{ data: sparkData }],
        tooltip: { enabled: false }
      }).render();
    }, 100);
  });

  $("#cards").html(html);
}

$(document).ready(function() {
  loadData();
  setInterval(loadData, 2500);
});
</script>

