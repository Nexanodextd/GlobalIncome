  <style>
    .coin-row.active {
      background: #e0f7fa;

    }

    .coin-row {
      cursor: pointer;
      transition: 0.2s;
    }

    .coin-row:hover {
      background: #f5f5f5;
    }

    .coin-row td {
      vertical-align: middle;
      font-size: 14px;
    }

    /* 📱 Mobile optimization */
    @media (max-width: 768px) {
      .coin-row td {
        font-size: 12px;
      }

      .coin-row img {
        width: 18px;
      }
    }
    thead {
    position: sticky;
    top: 0;
    background: white;
    z-index: 10;
}


    .ref-card {
      background: linear-gradient(135deg, #1e293b, #1f2a44);
      border-radius: 12px;
      padding: 25px;
      color: #fff;
    }

    .ref-link-box {
      background: #0f172a;
      border-radius: 8px;
      padding: 12px 15px;
      color: #ccc;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .copy-btn {
      background: #3b82f6;
      border: none;
    }

    .copy-btn:hover {
      background: #2563eb;
    }
   
    .market-card {
      background:#1a2332;
      border-radius:14px;
      padding:15px;
      height:160px;
      transition:.3s;
    }

    .market-card:hover { transform:translateY(-4px); }

    .symbol { font-size:13px; color:#9ca3af; }
    .name { font-size:11px; color:#6b7280; }
    .price { font-size:22px; font-weight:bold; }

    .positive { color:#22c55e; }
    .negative { color:#ef4444; }

    .spark { height:50px; }
    .time { font-size:11px; color:#6b7280; }
    .top-section{
        padding:70px 0 40px;
      text-align:center;
      border-bottom:1px solid rgba(255,255,255,0.08);
    }

    .top-section h1{
      font-size:22px;
      font-weight:200;
    }

    .top-section p{
      color:#9aa4b2;
      font-size:18px;
    }

    .alert-custom{
      background:#8f1717;
      border:none;
      color:#fff;
      border-radius:14px;
      padding:18px 22px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .quick-btn{
      background:#16253d;
      border:1px solid rgba(255,255,255,0.08);
      color:#fff;
      padding:10px 22px;
      border-radius:10px;
      transition:0.3s;
      margin-left: 0.5%;
    }

    .quick-btn:hover{
      background:#1d3354;
    }

    .card-custom{
     
      border:1px solid rgba(255,255,255,0.06);
      border-radius:16px;
      padding:30px;
      height:100%;
    }

    .form-control,
    .form-select{
      background:#13233d;
      border:1px solid rgba(255,255,255,0.08);
      color:#fff;
      height:50px;
    }

    .form-control:focus,
    .form-select:focus{
      background:#13233d;
      color:#fff;
      box-shadow:none;
      border-color:#355c9a;
    }

    .form-control::placeholder{
      color:#8f98a8;
    }

    .payment-item{
      background:#13233d;
      border-radius:12px;
      padding:16px;
      margin-bottom:14px;
      display:flex;
      align-items:center;
      gap:12px;
      cursor:pointer;
      transition:0.3s;
    }

    .payment-item:hover{
      background:#1b3153;
    }

    .secure-badge{
      background:#0c3d2b;
      color:#1bff93;
      border-radius:30px;
      padding:7px 18px;
      font-size:14px;
      display:inline-flex;
      align-items:center;
      gap:7px;
    }

    .deposit-btn{
      background:#0d6efd;
      border:none;
      height:52px;
      border-radius:12px;
      font-weight:600;
    }

    .deposit-btn:hover{
      background:#0b5ed7;
    }

    label{
      margin-bottom:10px;
      font-weight:600;
    }

  </style>

